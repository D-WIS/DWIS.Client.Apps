@page "/"



<PageTitle>DWIS Blackboard explorer</PageTitle>

<div class="dwis-page">

    @if (ShowQueryPage)
    {
        <QueryComponent></QueryComponent>
    }
    else if(ShowProviderPagePage)
    {
        <VariablesTreeView />
    }
    else if(ShowVocabularyPage)
    {
        <InstanceEdition />
    }
</div>

@code
{
    // [Parameter]
    // public bool DrawerOpen { get; set; }

    [Parameter]
    public bool ShowQueryPage { get; set; }

    [Parameter]
    public bool ShowProviderPagePage { get; set; }

    [Parameter]
    public bool ShowVocabularyPage { get; set; }
}
