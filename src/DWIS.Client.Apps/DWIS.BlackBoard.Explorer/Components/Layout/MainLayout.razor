@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout >

    <MudAppBar Fixed="true" Style="background-color:white; color:black; " >
        <MudImage Src="img/NORCE_Logo_Skjerm_Blaa.png" Height="30" Style="margin-top:5px"></MudImage>
        <MudSpacer />
        <MudText Typo="Typo.h3" Style="color:darkblue">Blackboard explorer</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.People" OnClick="() => ProviderView =true" DropShadow="@ProviderView">Provider view</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.LocationSearching" OnClick="() => QueryView = true" DropShadow="@QueryView">Query view</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.MenuBook" OnClick="() => VocabularyView = true"     DropShadow="@VocabularyView">Vocabulary view</MudButton>
       @*  <MudText Typo="Typo.h4">@(_showQueries ? "Query view" : "Provider view")</MudText>
        <MudSpacer /> *@
        @* < MudSwitch @bind-Value="@_showQueries" Label="Provider view / Query view"></MudSwitch>
        @if (!_showQueries)
        {
            <MudSwitch @bind-Value="@_drawerOpen" Label="@(_drawerOpen ? "Hide providers" : "Show providers")" Color="@(_drawerOpen ? Color.Success : Color.Warning)" ></MudSwitch>                    
        } 
        *@
    </MudAppBar>

    <MudMainContent Style="height:100vh">
        <DWIS.BlackBoard.Explorer.Components.Pages.Home ShowQueryPage="@_queryView" ShowProviderPagePage="@_providerView" ShowVocabularyPage="_vocabularyView" />
    </MudMainContent>

</MudLayout>

@code{
    bool _providerView = true;
    bool _queryView = false;
    bool _vocabularyView = false;

    bool ProviderView
    { 
        get { return _providerView; }
        set {
            _providerView = value;
            if (_providerView) { _queryView = false; _vocabularyView = false; }
        } 
    }
    bool QueryView
    { 
        get { return _queryView; }
        set {
            _queryView = value; if (_queryView) { _vocabularyView = false; _providerView = false; }
        } 
    }
    bool VocabularyView
    { 
        get { return _vocabularyView; }
        set {
            _vocabularyView = value;
            if (_vocabularyView) { _queryView = false; _providerView = false; }
        } 
    }
}
